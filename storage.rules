rules_version = '2';

// Dartmouth Swimming Alumni Archive — Storage security rules
// Deploy: npx firebase-tools deploy --only storage
// Membership is read from Firestore (users/{uid}.status), so the first deploy
// asks to let Storage read Firestore — accept it.

service firebase.storage {
  match /b/{bucket}/o {

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isMember() {
      return request.auth != null && profile().get('status', '') == 'member';
    }

    function isAdmin() {
      return isMember() && profile().get('role', '') == 'admin';
    }

    match /memories/{memoryId}/{fileName} {
      allow read: if isMember();

      allow create: if isMember()
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf')
        && request.resource.metadata.uploadedBy == request.auth.uid;

      allow delete: if isMember()
        && (resource.metadata.uploadedBy == request.auth.uid || isAdmin());
    }
  }
}
